APP_NAME=simple-rag
APP_VERSION=0.1.0

FILE_SUPPORTED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

DATABASE_BACKEND=postgres
POSTGRES_URI=postgresql+asyncpg://user:password@localhost:5432/database_name

GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=OPENAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_API_URL=
COHERE_API_KEY=
GENERATION_MODEL_ID=gpt-4o-mini
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_MODEL_SIZE=768

INPUT_MAX_CHARACTERS=1024
OUTPUT_MAX_TOKENS=400
TEMPERATURE=0.1

VECTOR_DB_BACKEND=PGVECTOR
DATA_DIR=data
OCR_LANGUAGES=eng+ara
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSDATA_DIR=C:/Program Files/Tesseract-OCR/tessdata
VECTOR_DB_PATH=vector_db
VECTOR_DB_DISTANCE_METRIC=cosine
PGVECTOR_INDEX_TYPE=hnsw

PRIMARY_LANG=en
DEFAULT_LANG=en
